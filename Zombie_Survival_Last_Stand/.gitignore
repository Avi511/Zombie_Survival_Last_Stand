# This .gitignore file should be placed at the root of the Unity project directory.

# Unity temporary & generated folders
/[L-l]ibrary/
/[T-t]emp/
/[O-o]bj/
/[B-b]uild/
/[B-b]uilds/
/[L-l]ogs/
/[U-u]ser[S-s]ettings/
/[M-m]emory[C-c]aptures/
/[R-r]ecordings/

# Asset Store tools
/[A-a]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin files
/[A-a]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Visual Studio Code / MonoDevelop / Rider generated files and folders
.vs/
.idea/
.vscode/
/*.csproj
/*.unityproj
/*.sln
/*.suo
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.opendb
/*.db
*.pidb.meta
*.pdb.meta
*.po.meta

# Unity unit tests results
/[R-r]eport/

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crash reports
sysinfo.txt

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
